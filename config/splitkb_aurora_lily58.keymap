#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/rgb.h>

// timeout for tap-dance
#define TD_TIMEOUT         150
#define TD_TIMEOUT_LONG    300

#define BASE 0
#define M1   1

#define FX_21 F21 RGB_COLOR_HSB(321, 58, 100)

/ {
    behaviors {
        m0_cmdtab: m0_cmdtab {
            compatible = "zmk,behavior-mod-morph";
            label = "m0_cmdtab";
            #binding-cells = <0>;
            bindings = <&mt F20 ESC>, <&kp TAB>;
            mods = <(MOD_LGUI)>;
            keep-mods = <(MOD_LGUI)>;
        };
        m1_grave_bslh: m1_grave_bslh {
            compatible = "zmk,behavior-mod-morph";
            label = "grave_bslh";
            #binding-cells = <0>;
            bindings = <&lt M1 BSLH>, <&kp GRAVE>;
            mods = <(MOD_LGUI)>;
            keep-mods = <(MOD_LGUI)>;
        };
    };

    macros {
      fx: fx {
          compatible = "zmk,behavior-macro-two-param";
          wait-ms = <0>;
          tap-ms = <0>;
          #binding-cells = <2>;
          bindings
              = <&macro_param_1to1>
              , <&macro_press &kp MACRO_PLACEHOLDER>
              , <&macro_param_2to1>
              , <&macro_tap &rgb_ug MACRO_PLACEHOLDER>
              , <&macro_tap &rgb_ug RGB_ON>
              , <&macro_pause_for_release>
              , <&macro_param_1to1>
              , <&macro_release &kp MACRO_PLACEHOLDER>
              , <&macro_tap &rgb_ug RGB_OFF>
              ;
      };
      fx_21: fx_21 {
        compatible = "zmk,behavior-macro";
        #binding-cells = <0>;
        bindings
            = <&macro_press &kp F21>
            , <&macro_tap &rgb_ug RGB_COLOR_HSB(321, 58, 100)>
            , <&macro_tap &rgb_ug RGB_ON>
            , <&macro_pause_for_release>
            , <&macro_release &kp F21>
            , <&macro_tap &rgb_ug RGB_OFF>
            ;
      };
    };
    behaviors {
        td_F22_M1: td_F22_M1 {
            compatible = "zmk,behavior-tap-dance";
            label = "td_F22_M1";
            #binding-cells = <0>;
            tapping-term-ms = <TD_TIMEOUT_LONG>;
            bindings = <&kp F22>, <&mo M1>;
        };
    };
    combos {
        compatible = "zmk,combos";

        combo_out_tog {
            timeout-ms = <50>;
            key-positions = <37 53>;
            bindings = <&out OUT_TOG>;
        };
        // BT combos
        combo_bt_sel_0 {
            timeout-ms = <50>;
            key-positions = <38 53>; // Lower + 6
            bindings = <&bt BT_SEL 0>;
        };
        combo_bt_sel_1 {
            timeout-ms = <50>;
            key-positions = <39 53>; // Lower + 7
            bindings = <&bt BT_SEL 1>;
        };
        combo_bt_clr {
            timeout-ms = <50>;
            key-positions = <51 53>; // Lower + LGUI
            bindings = <&bt BT_CLR>;
        };

        // Media combos
        combo_play_pause {
            timeout-ms = <50>;
            key-positions = <4 5>;
            bindings = <&kp C_PP>;
        };
        combo_media_next {
            timeout-ms = <50>;
            key-positions = <5 17>;
            bindings = <&kp C_NEXT>;
        };
        combo_media_prev {
            timeout-ms = <50>;
            key-positions = <17 29>;
            bindings = <&kp C_PREV>;
        };

        // TAB
        combo_tab {
            timeout-ms = <75>;
            key-positions = <12 13>;
            bindings = <&kp TAB>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // +---------------------------------------------------------------------------------------------------------------------------------------------------------+
            // |          |          |          |          |          |          |                        |          |          |          |          |          |       |
            // |          |          |          |          |          |          |                        |          |          |          |          |          |       |
            // |          |          |          |          |          |          |                        |          |          |          |          |          |       |
            // |          |          |          |          |          |          |          |  |          |          |          |          |          |          |       |
            //                                  |          |          |          |          |  |          |          |          |          |
            bindings = <
                &kp N1      &kp N2      &kp N3      &kp N4      &kp N5      &kp N6                           &kp N7      &kp N8      &kp N9      &kp N0      &kp MINUS   &kp EQUAL
                &m0_cmdtab  &kp Q       &kp W       &kp E       &kp R       &kp T                            &kp Y       &kp U       &kp I       &kp O       &kp P       &kp BSPC
                &kp LSHFT   &kp A       &kp S       &kp D       &kp F       &kp G                            &kp H       &kp J       &kp K       &kp L       &kp SEMI    &kp APOS
                &td_F22_M1  &kp Z       &kp X       &kp C       &kp V       &kp B      &none       &none     &kp N       &kp M       &kp COMMA   &kp DOT     &kp FSLH    &kp LCTRL
                                        &kp LALT    &fx_21      &kp SPACE   &kp LGUI                         &kp F24     &kp F23     &kp F19     &kp BSLH
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        M1_layer { // RGB
            // +------------------------------------------------------------------------------------------------------------------------------------------------------------+
            // |          |          |          |          |          |          |                        |          |          |          |          |          |          |
            // |          |          |          |          |          |          |                        |          |          |          |          |          |          |
            // |          |          |          |          |          |          |                        |          |          |          |          |          |          |
            // |          |          |          |          |          |          |          |  |          |          |          |          |          |          |          |
            //                                  |          |          |          |          |  |          |          |          |          |
            bindings = <
                &rgb_ug RGB_TOG  &rgb_ug RGB_SPI  &rgb_ug RGB_SAI  &rgb_ug RGB_HUI  &rgb_ug RGB_BRI  &ext_power EP_ON                                  &trans   &trans  &trans    &trans  &trans    &trans
                &rgb_ug RGB_EFF  &rgb_ug RGB_SPD  &rgb_ug RGB_SAD  &rgb_ug RGB_HUD  &rgb_ug RGB_BRD  &ext_power EP_OFF                                 &trans   &trans  &trans    &trans  &trans    &trans
                &rgb_ug RGB_EFR  &trans           &trans           &trans           &trans           &trans                                            &trans   &trans  &trans    &trans  &trans    &trans
                &trans           &trans           &trans           &trans           &trans           &trans             &trans      &trans             &trans   &trans  &trans    &trans  &trans    &trans
                                                  &trans           &trans           &trans           &trans                                            &trans   &trans  &trans    &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

    };
};
